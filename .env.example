# Plantilla de variables del panel admin. Copia este archivo a `.env.local` (git-ignorado) y ajusta el valor.
# Vite incrusta las variables VITE_* en el bundle: son PÚBLICAS. Nunca pongas secretos aquí.

# URL base del backend, sin "/" final. Obligatoria (sin ella las peticiones salen relativas al propio admin).
# Local: http://localhost:8080 · Producción: la URL pública del backend (pídela al responsable).
VITE_BACKEND_URL=http://localhost:8080
